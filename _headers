# Security headers for static hosts that read this file
# (Netlify, Cloudflare Pages). On Vercel use vercel.json; on Apache, .htaccess;
# on nginx, add_header. This is a static site: no cookies, no sessions, no
# forms, no backend — so there is nothing here to protect with CSRF tokens or
# auth, and these headers are the real surface.

/*
  # HSTS. Only meaningful once the site is served over HTTPS on its own domain.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  # Scripts and styles are all first-party; the only third party is Google
  # Fonts. frame-ancestors 'none' is the CSP equivalent of X-Frame-Options.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src https://www.google.com; form-action 'none'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate
